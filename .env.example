# Misma base que el backend SquareOne: DB clubsync, esquema fide (puerto local 5435 con `docker compose` raíz).
DATABASE_URL=postgresql://clubsync:clubsync@localhost:5435/clubsync

# Nombre en PostgreSQL (pg_stat_activity / logs). Default: fide-scraper. Env: FIDE_SCRAPER_PG_APPLICATION_NAME
# FIDE_SCRAPER_PG_APPLICATION_NAME=fide-scraper

# URL de descarga FIDE (ver https://ratings.fide.com/download_lists.phtml)
# Por defecto lista combinada STD+RPD+BLZ (alineado con el backend SquareOne)
# Combinada oficial (misma que "Combined list STD, BLZ, RPD" XML en ratings.fide.com)
FIDE_XML_URL=https://ratings.fide.com/download/players_list_xml.zip

# Si se define, la API exige header X-API-Key en todas las rutas /players/*
# FIDE_SCRAPER_API_KEY=tu_secreto
# Para /admin/* se recomienda allowlist de Jenkins (IP o CIDR, separados por coma)
# FIDE_SCRAPER_ADMIN_ALLOWLIST=203.0.113.10/32,198.51.100.0/24
# Con proxy/reverse proxy: toma el primer X-Forwarded-For
FIDE_SCRAPER_TRUST_FORWARDED_FOR=true

# Directorio para exportaciones JSON/CSV
EXPORT_PATH=data/exports

# Nivel de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Import historial conservador (scripts.run_import_history; si no usás flags en CLI)
# FIDE_HISTORY_COUNTRY_CODES=PAR
# FIDE_HISTORY_PERIOD_SCOPE=current_year
# FIDE_HISTORY_INCLUDE_CLUB_AFFILIATES=false
